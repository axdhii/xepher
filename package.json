{
  "name": "xepher",
  "version": "1.0.0",
  "description": "Xepher: a floating robot that drives Claude Code",
  "private": true,
  "main": "desktop/main.cjs",
  "author": "Aadhil",
  "scripts": {
    "dev": "vite web",
    "build": "vite build web",
    "typecheck": "tsc -p web --noEmit",
    "test": "node --experimental-strip-types --test web/src/*.test.ts desktop/*.test.cjs",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win zip nsis --x64 --publish never"
  },
  "build": {
    "appId": "dev.xepher.app",
    "productName": "Xepher",
    "files": [
      "desktop/**",
      "dist/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "desktop/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "runAfterFinish": true
    },
    "publish": null
  },
  "devDependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
